@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix ex: <http://www.example.com/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix mopo-eu: <https://spine-tools.github.io/mopo-data-catalog-of-the-pan-european-framework-for-energy-system-modelling/data-catalog/data-catalog/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix plcy: <https://www.uuidea.eu/policy/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sdcc: <https://www.uuidea.eu/sdc-catalog/> .
@prefix sdcdc: <https://www.uuidea.eu/profiles/data-catalog> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix uuidea: <https://data-catalog.uuidea.eu/data-catalog/data-catalog/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:abcde a dcat:DatasetSeries ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "My name" ] ;
    dcterms:title "all the datasets by this publisher" .

ex:mopo-eu-distribution a dcat:Distribution ;
    dcterms:format "text/turtle" ;
    dcat:accessURL "https://spine-tools.github.io/mopo-data-catalog-of-the-pan-european-framework-for-energy-system-modelling/data-catalog/data-catalog/_attachments/data-catalog.ttl" .

ex:sfasdggfvrln a dqv:QualityMeasurement ;
    dqv:computedOn ex:herrcgre ;
    dqv:isMeasurementOf ex:fkrhkqewjewrc ;
    dqv:value "0.9"^^xsd:float ;
    prov:generatedAtTime "2025-04-22"^^xsd:date .

ex:uuidea-distribution a dcat:Distribution ;
    dcterms:format "text/turtle" ;
    dcat:accessURL "https://data-catalog.uuidea.eu/data-catalog/data-catalog/_attachments/data-catalog.ttl" .

uuidea:uuidea_Data_Catalog a dcat:Dataset ;
    dcterms:description """This data catalog shows an overview of the datasets uuidea has contributed to.
Fun fact the cataloging framework that is used for this catalog is developed by uuidea as well. To learn more, click on the GitHub button in the top right corner.
""" ;
    dcterms:license [ a dcterms:LicenseDocument ;
            dcterms:title "https://creativecommons.org/licenses/by-nc-nd/4.0/" ] ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "uuidea" ] ;
    dcterms:title "uuidea Data Catalog" ;
    vcard:contactPoint [ a vcard:Kind ;
            vcard:hasEmail "joep @ uuidea . eu" ] ;
    dcat:distribution ex:uuidea-distribution ;
    dcat:theme sdcc:data-catalog .

mopo-eu:Mopo_Data_Catalog_of_the_Pan-European_Framework_for_Energy_System_Modeling a dcat:Dataset ;
    dcterms:description """Data catalog for the Pan-European Framework for Energy System Modelling (Spine Project).
""" ;
    dcterms:license [ a dcterms:LicenseDocument ;
            dcterms:title "https://creativecommons.org/licenses/by/4.0/" ] ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "spine-tools" ] ;
    dcterms:title "MoPo Data Catalog of the Pan-European Framework for Energy System Modelling" ;
    dcat:distribution ex:mopo-eu-distribution ;
    dcat:theme sdcc:data-catalog .

plcy:make-accessible a odrl:Duty ;
    dcterms:description """The provider must make the data available through an appropriate
protocol so that consumers can retrieve it without restriction.
""" ;
    odrl:action "make_available" ;
    odrl:assignee "Data Provider" .

plcy:open-info-access a odrl:Permission ;
    dcterms:description """Allows any consumer to access the data.
""" ;
    odrl:action "access" ;
    odrl:assignee "Data Consumer" .

plcy:open-information-policy a odrl:Policy ;
    dcterms:description """Open Information policy for the project.  
It ensures that data is Findable, Accessible, Interoperable, and Reusable (FAIR).
""" ;
    dcterms:title "open information policy" ;
    odrl:obligation plcy:make-accessible,
        plcy:provide-license,
        plcy:provide-rights-statement,
        plcy:register-in-catalog ;
    odrl:permission plcy:open-info-access .

plcy:provide-license a odrl:Duty ;
    dcterms:description """The publisher must provide an open‑source or Creative‑Commons licence
describing how the data may be used.
""" ;
    odrl:action "provide" ;
    odrl:assignee "Data Provider" .

plcy:provide-rights-statement a odrl:Duty ;
    dcterms:description """The publisher must provide a rights statement (e.g., from rightsstatements.org)
indicating any intellectual‑property or copy rights.
""" ;
    odrl:action "provide" ;
    odrl:assignee "Data Provider" .

plcy:register-in-catalog a odrl:Duty ;
    dcterms:description """The publisher must register the data in the project catalog so it is findable.
""" ;
    odrl:action "register" ;
    odrl:assignee "Data Provider" .

sdcc:Catalog_of_simple_data_catalog_Catalogs a dcat:Catalog ;
    dcterms:description """This catalog provides an overview of Catalogs that use the simple_data_catalog to publish their data. Contribution to this catalog is voluntary, but very much appreciated. Adding your data catalog to this one helps other find eachother and each others data. It allows us to build a community and make our data even more findable. 
""" ;
    dcterms:license [ a dcterms:LicenseDocument ;
            dcterms:title "https://creativecommons.org/licenses/by-sa/4.0/" ] ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "https://www.linkedin.com/in/joep-van-genuchten-a6836751/[Joep van Genuchten]" ] ;
    dcterms:title "Catalog of simple_data_catalog Catalogs" .

ex:fkrhkqewjewrc a dqv:Metric ;
    skos:definition "an example of a data quality metric" ;
    skos:prefLabel "example metric" ;
    dqv:expectedDataType xsd:float ;
    dqv:inDimension "Completeness" .

sdcc:data-catalog a skos:Concept ;
    skos:altLabel "catalog" ;
    skos:definition "A curated collection of metadata about datasets, providing information about data resources, their characteristics, and how to access them" ;
    skos:prefLabel "data catalog" .

[] a sdcdc:Container ;
    sdcdc:concepts sdcc:data-catalog ;
    sdcdc:dataCatalog sdcc:Catalog_of_simple_data_catalog_Catalogs ;
    sdcdc:datasets uuidea:uuidea_Data_Catalog,
        mopo-eu:Mopo_Data_Catalog_of_the_Pan-European_Framework_for_Energy_System_Modeling ;
    sdcdc:metrics ex:fkrhkqewjewrc ;
    sdcdc:policies plcy:open-information-policy ;
    sdcdc:qualityMeasurements ex:sfasdggfvrln ;
    sdcdc:series ex:abcde .

